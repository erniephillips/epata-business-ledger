    "test:browser:headed": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./tools/run-playwright.ps1 tests/playwright/control-contracts.spec.cjs tests/playwright/global-shell-controls.spec.cjs tests/playwright/generic-control-actions.spec.cjs tests/playwright/relationship-control-actions.spec.cjs tests/playwright/operational-workflows.spec.cjs tests/playwright/control-gap-workflows.spec.cjs tests/playwright/sidebar-modals.spec.cjs tests/playwright/main-shell-state-stress.spec.cjs tests/playwright/invoice-builder-workflow.spec.cjs tests/playwright/invoice-state-stress.spec.cjs tests/playwright/navigation-upload-responsive.spec.cjs tests/playwright/intake-ai-state-stress.spec.cjs tests/playwright/visual-layout-audit.spec.cjs tests/playwright/final-checklist-closure.spec.cjs --headed",
    "test:visual": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./tools/run-playwright.ps1 tests/playwright/visual-regression.spec.cjs",
    "test:visual:update": "set EPATA_UPDATE_VISUAL_BASELINES=1&& pwsh -NoProfile -ExecutionPolicy Bypass -File ./tools/run-playwright.ps1 tests/playwright/visual-regression.spec.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
